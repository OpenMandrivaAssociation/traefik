diff -ruN a/pkg/modules/loader.go b/pkg/modules/loader.go
--- a/pkg/modules/loader.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/loader.go	2026-08-31 21:01:21.549431688 +0200
@@ -0,0 +1,124 @@
+package modules
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"plugin"
+	"strings"
+
+	"github.com/rs/zerolog/log"
+)
+
+const (
+	// DefaultModuleDir is the default directory where module .so files are located.
+	DefaultModuleDir = "/usr/lib/traefik/modules"
+
+	// ModuleFileSuffix is the file extension for module shared objects.
+	ModuleFileSuffix = ".so"
+
+	// ModuleInitSymbol is the symbol name every module .so must export.
+	// It must be a function: func() Module
+	ModuleInitSymbol = "NewModule"
+)
+
+// Loader discovers and loads external module .so files from the filesystem.
+type Loader struct {
+	dirs []string
+}
+
+// NewLoader creates a Loader that searches the given directories for modules.
+// If no directories are given, DefaultModuleDir is used.
+func NewLoader(dirs ...string) *Loader {
+	if len(dirs) == 0 {
+		dirs = []string{DefaultModuleDir}
+	}
+	return &Loader{dirs: dirs}
+}
+
+// DiscoverAndRegister scans all configured directories for .so files,
+// loads each one, and registers the module in the given registry.
+// Missing directories are silently skipped (graceful degradation when a
+// module file is simply not installed).
+func (l *Loader) DiscoverAndRegister(registry *Registry) []error {
+	var errs []error
+
+	for _, dir := range l.dirs {
+		dirErrs := l.loadFromDir(dir, registry)
+		errs = append(errs, dirErrs...)
+	}
+
+	return errs
+}
+
+func (l *Loader) loadFromDir(dir string, registry *Registry) []error {
+	var errs []error
+
+	info, err := os.Stat(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			log.Debug().Str("dir", dir).Msg("Module directory does not exist, skipping")
+			return nil
+		}
+		return []error{fmt.Errorf("stat module directory %s: %w", dir, err)}
+	}
+
+	if !info.IsDir() {
+		return []error{fmt.Errorf("module path %s is not a directory", dir)}
+	}
+
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return []error{fmt.Errorf("reading module directory %s: %w", dir, err)}
+	}
+
+	for _, entry := range entries {
+		if entry.IsDir() {
+			continue
+		}
+		if !strings.HasSuffix(entry.Name(), ModuleFileSuffix) {
+			continue
+		}
+
+		soPath := filepath.Join(dir, entry.Name())
+		mod, err := loadModuleFromSO(soPath)
+		if err != nil {
+			log.Warn().Err(err).Str("file", soPath).Msg("Failed to load module from .so file")
+			errs = append(errs, err)
+			continue
+		}
+
+		if err := registry.Register(mod); err != nil {
+			log.Warn().Err(err).Str("file", soPath).Msg("Failed to register module from .so file")
+			errs = append(errs, err)
+			continue
+		}
+
+		log.Info().
+			Str("module", mod.Info().Name).
+			Str("file", soPath).
+			Str("version", mod.Info().Version).
+			Msg("Loaded external module")
+	}
+
+	return errs
+}
+
+func loadModuleFromSO(path string) (Module, error) {
+	p, err := plugin.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("opening plugin %s: %w", path, err)
+	}
+
+	sym, err := p.Lookup(ModuleInitSymbol)
+	if err != nil {
+		return nil, fmt.Errorf("plugin %s does not export %s: %w", path, ModuleInitSymbol, err)
+	}
+
+	newModule, ok := sym.(func() Module)
+	if !ok {
+		return nil, fmt.Errorf("plugin %s: %s has wrong signature (want func() Module)", path, ModuleInitSymbol)
+	}
+
+	return newModule(), nil
+}
diff -ruN a/pkg/modules/manager.go b/pkg/modules/manager.go
--- a/pkg/modules/manager.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/manager.go	2026-08-31 21:01:21.549481039 +0200
@@ -0,0 +1,276 @@
+package modules
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/rs/zerolog/log"
+)
+
+const (
+	// DefaultIdleTimeout is the default duration after which an idle module is unloaded.
+	DefaultIdleTimeout = 10 * time.Minute
+
+	// DefaultCheckInterval is how often the manager checks for idle modules.
+	DefaultCheckInterval = 1 * time.Minute
+)
+
+// moduleEntry tracks the runtime state of a module within the manager.
+type moduleEntry struct {
+	module       Module
+	state        ModuleState
+	lastAccessed time.Time
+	loadErr      error
+	essential    bool // essential modules are never unloaded.
+}
+
+// Manager handles the lifecycle of modules — loading on demand, tracking access
+// times, and unloading modules that have been idle too long.
+type Manager struct {
+	registry      *Registry
+	staticCfg     any // *static.Configuration, passed as any to avoid import cycle.
+	idleTimeout   time.Duration
+	checkInterval time.Duration
+
+	mu      sync.Mutex
+	entries map[string]*moduleEntry
+	cancel  context.CancelFunc
+}
+
+// ManagerOption configures a Manager.
+type ManagerOption func(*Manager)
+
+// WithIdleTimeout sets the idle timeout for module unloading.
+func WithIdleTimeout(d time.Duration) ManagerOption {
+	return func(m *Manager) {
+		m.idleTimeout = d
+	}
+}
+
+// WithCheckInterval sets how often the manager checks for idle modules.
+func WithCheckInterval(d time.Duration) ManagerOption {
+	return func(m *Manager) {
+		m.checkInterval = d
+	}
+}
+
+// NewManager creates a new module lifecycle manager.
+// cfg should be a pointer to static.Configuration (passed as any to avoid import cycle).
+func NewManager(registry *Registry, cfg any, opts ...ManagerOption) *Manager {
+	m := &Manager{
+		registry:      registry,
+		staticCfg:     cfg,
+		idleTimeout:   DefaultIdleTimeout,
+		checkInterval: DefaultCheckInterval,
+		entries:       make(map[string]*moduleEntry),
+	}
+
+	for _, opt := range opts {
+		opt(m)
+	}
+
+	// Create entries for all registered modules.
+	for _, mod := range registry.List() {
+		info := mod.Info()
+		m.entries[info.Name] = &moduleEntry{
+			module: mod,
+			state:  StateUnloaded,
+		}
+	}
+
+	return m
+}
+
+// MarkEssential marks a module as essential — it will never be auto-unloaded.
+func (m *Manager) MarkEssential(name string) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if entry, ok := m.entries[name]; ok {
+		entry.essential = true
+	}
+}
+
+// Start begins the idle-check goroutine. Call Stop() to shut it down.
+func (m *Manager) Start(ctx context.Context) {
+	ctx, m.cancel = context.WithCancel(ctx)
+
+	go m.idleCheckLoop(ctx)
+
+	log.Info().
+		Int("moduleCount", len(m.entries)).
+		Dur("idleTimeout", m.idleTimeout).
+		Msg("Module manager started")
+}
+
+// Stop shuts down the idle-check goroutine and unloads all modules.
+func (m *Manager) Stop(ctx context.Context) {
+	if m.cancel != nil {
+		m.cancel()
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	for name, entry := range m.entries {
+		if entry.state == StateLoaded {
+			log.Info().Str("module", name).Msg("Unloading module on shutdown")
+			if err := entry.module.Unload(ctx); err != nil {
+				log.Error().Err(err).Str("module", name).Msg("Error unloading module on shutdown")
+			}
+			entry.state = StateUnloaded
+		}
+	}
+}
+
+// EnsureLoaded loads a module if it is not already loaded, records an access,
+// and returns the module. This is the primary method consumers call.
+func (m *Manager) EnsureLoaded(ctx context.Context, name string) (Module, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	entry, ok := m.entries[name]
+	if !ok {
+		return nil, fmt.Errorf("module %q is not registered", name)
+	}
+
+	entry.lastAccessed = time.Now()
+
+	if entry.state == StateLoaded {
+		return entry.module, nil
+	}
+
+	if entry.state == StateError && entry.loadErr != nil {
+		log.Warn().Str("module", name).Msg("Retrying previously failed module load")
+	}
+
+	entry.state = StateLoading
+	log.Info().Str("module", name).Msg("Loading module on demand")
+
+	if err := entry.module.Load(ctx, m.staticCfg); err != nil {
+		entry.state = StateError
+		entry.loadErr = err
+		log.Error().Err(err).Str("module", name).Msg("Failed to load module")
+		return nil, fmt.Errorf("loading module %q: %w", name, err)
+	}
+
+	entry.state = StateLoaded
+	entry.loadErr = nil
+	log.Info().Str("module", name).Msg("Module loaded successfully")
+	return entry.module, nil
+}
+
+// Touch records a recent access for a module, preventing idle unloading.
+func (m *Manager) Touch(name string) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if entry, ok := m.entries[name]; ok {
+		entry.lastAccessed = time.Now()
+	}
+}
+
+// UnloadModule explicitly unloads a module.
+func (m *Manager) UnloadModule(ctx context.Context, name string) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.unloadLocked(ctx, name)
+}
+
+func (m *Manager) unloadLocked(ctx context.Context, name string) error {
+	entry, ok := m.entries[name]
+	if !ok {
+		return fmt.Errorf("module %q is not registered", name)
+	}
+
+	if entry.state != StateLoaded {
+		return nil
+	}
+
+	entry.state = StateUnloading
+	log.Info().Str("module", name).Msg("Unloading idle module")
+
+	if err := entry.module.Unload(ctx); err != nil {
+		entry.state = StateError
+		entry.loadErr = err
+		return fmt.Errorf("unloading module %q: %w", name, err)
+	}
+
+	entry.state = StateUnloaded
+	log.Info().Str("module", name).Msg("Module unloaded")
+	return nil
+}
+
+// GetState returns the current state of a module.
+func (m *Manager) GetState(name string) (ModuleState, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	entry, ok := m.entries[name]
+	if !ok {
+		return StateUnloaded, fmt.Errorf("module %q is not registered", name)
+	}
+	return entry.state, nil
+}
+
+// ModuleStatus contains status information for a module.
+type ModuleStatus struct {
+	Name         string
+	Type         ModuleType
+	State        ModuleState
+	LastAccessed time.Time
+	Essential    bool
+	LoadError    error
+}
+
+// Status returns status information for all modules.
+func (m *Manager) Status() []ModuleStatus {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	result := make([]ModuleStatus, 0, len(m.entries))
+	for name, entry := range m.entries {
+		result = append(result, ModuleStatus{
+			Name:         name,
+			Type:         entry.module.Info().Type,
+			State:        entry.state,
+			LastAccessed: entry.lastAccessed,
+			Essential:    entry.essential,
+			LoadError:    entry.loadErr,
+		})
+	}
+	return result
+}
+
+func (m *Manager) idleCheckLoop(ctx context.Context) {
+	ticker := time.NewTicker(m.checkInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			m.unloadIdleModules(ctx)
+		}
+	}
+}
+
+func (m *Manager) unloadIdleModules(ctx context.Context) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	now := time.Now()
+	for name, entry := range m.entries {
+		if entry.state != StateLoaded {
+			continue
+		}
+		if entry.essential {
+			continue
+		}
+		if now.Sub(entry.lastAccessed) > m.idleTimeout {
+			if err := m.unloadLocked(ctx, name); err != nil {
+				log.Error().Err(err).Str("module", name).Msg("Failed to unload idle module")
+			}
+		}
+	}
+}
diff -ruN a/pkg/modules/mod_dashboard.go b/pkg/modules/mod_dashboard.go
--- a/pkg/modules/mod_dashboard.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/mod_dashboard.go	2026-08-31 21:01:21.549528599 +0200
@@ -0,0 +1,150 @@
+package modules
+
+import (
+	"io/fs"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/rs/zerolog/log"
+)
+
+// DashboardHandler wraps the webui module and provides on-demand loading.
+// When a request arrives, the webui module is loaded if not already loaded.
+// The module manager tracks last access and unloads idle modules after the
+// configured idle timeout.
+type DashboardHandler struct {
+	manager *Manager
+	inner   http.Handler
+
+	mu         sync.Mutex
+	lastAccess time.Time
+}
+
+// NewDashboardHandler creates an HTTP handler that loads the webui module
+// on demand when dashboard requests arrive.
+//
+// fallbackHandler is used when the webui module has no assets, or when it
+// implements WithAssets(fs.FS) http.Handler so module assets can be injected
+// into the traditional dashboard.Handler (templates + CSP headers).
+func NewDashboardHandler(manager *Manager, fallbackHandler http.Handler) *DashboardHandler {
+	return &DashboardHandler{
+		manager: manager,
+		inner:   fallbackHandler,
+	}
+}
+
+// ServeHTTP handles dashboard requests, loading the webui module on demand.
+func (h *DashboardHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	h.mu.Lock()
+	h.lastAccess = time.Now()
+	h.mu.Unlock()
+
+	// Touch the module to reset idle timer.
+	h.manager.Touch(WebUIModuleName)
+
+	// Ensure the module is loaded.
+	mod, err := h.manager.EnsureLoaded(r.Context(), WebUIModuleName)
+	if err != nil {
+		log.Error().Err(err).Msg("Failed to load webui module for dashboard")
+		// Fall back to the traditional handler (embedded assets) if present.
+		if h.inner != nil {
+			h.inner.ServeHTTP(w, r)
+			return
+		}
+		http.Error(w, "Dashboard temporarily unavailable", http.StatusServiceUnavailable)
+		return
+	}
+
+	webui, ok := mod.(WebUIModule)
+	if !ok || webui.Assets() == nil {
+		// Module loaded but no assets available — serve fallback.
+		if h.inner != nil {
+			h.inner.ServeHTTP(w, r)
+			return
+		}
+		http.Error(w, "Dashboard assets not available", http.StatusNotFound)
+		return
+	}
+
+	// Prefer the fallback handler when it can consume module assets
+	// (dashboard.Handler with BasePath + index template injection).
+	if h.inner != nil {
+		if withAssets, ok := h.inner.(interface{ WithAssets(fs.FS) http.Handler }); ok {
+			withAssets.WithAssets(webui.Assets()).ServeHTTP(w, r)
+			return
+		}
+	}
+
+	// Serve the module assets directly.
+	http.FileServerFS(webui.Assets()).ServeHTTP(w, r)
+}
+
+// ResolveWebUIAssets loads the webui module (if needed) and returns its assets.
+// Returns nil, nil when the module is present but has no assets.
+func ResolveWebUIAssets(manager *Manager, r *http.Request) (fs.FS, error) {
+	if manager == nil {
+		return nil, nil
+	}
+	manager.Touch(WebUIModuleName)
+	mod, err := manager.EnsureLoaded(r.Context(), WebUIModuleName)
+	if err != nil {
+		return nil, err
+	}
+	webui, ok := mod.(WebUIModule)
+	if !ok {
+		return nil, nil
+	}
+	return webui.Assets(), nil
+}
+
+// DashboardMiddleware returns a middleware that ensures the webui module is
+// loaded when dashboard routes are accessed, and touches the module on each
+// request.
+func DashboardMiddleware(manager *Manager, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Touch the module to record activity.
+		manager.Touch(WebUIModuleName)
+
+		// Ensure it's loaded (the real dashboard handler inside next will use it).
+		if _, err := manager.EnsureLoaded(r.Context(), WebUIModuleName); err != nil {
+			log.Warn().Err(err).Msg("Could not ensure webui module loaded")
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
+
+// ModuleStatusHandler serves a JSON endpoint showing the status of all modules.
+func ModuleStatusHandler(manager *Manager) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		ctx := r.Context()
+		_ = ctx
+
+		statuses := manager.Status()
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+
+		// Simple JSON output.
+		_, _ = w.Write([]byte(`{"modules":[`))
+		for i, s := range statuses {
+			if i > 0 {
+				_, _ = w.Write([]byte(","))
+			}
+			essential := "false"
+			if s.Essential {
+				essential = "true"
+			}
+			errMsg := ""
+			if s.LoadError != nil {
+				errMsg = s.LoadError.Error()
+			}
+			line := `{"name":"` + s.Name +
+				`","state":"` + s.State.String() +
+				`","essential":` + essential +
+				`,"error":"` + errMsg + `"}`
+			_, _ = w.Write([]byte(line))
+		}
+		_, _ = w.Write([]byte("]}"))
+	}
+}
diff -ruN a/pkg/modules/mod_provider.go b/pkg/modules/mod_provider.go
--- a/pkg/modules/mod_provider.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/mod_provider.go	2026-08-31 21:01:21.549559980 +0200
@@ -0,0 +1,89 @@
+package modules
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+
+	"github.com/rs/zerolog/log"
+	"github.com/traefik/traefik/v3/pkg/provider"
+)
+
+// ProviderFactory is a function that creates a provider from the static configuration.
+// The cfg parameter is a pointer to static.Configuration (passed as any).
+type ProviderFactory func(cfg any) (provider.Provider, error)
+
+// ProviderConfigChecker checks whether a provider is configured.
+// The cfg parameter is a pointer to static.Configuration (passed as any).
+type ProviderConfigChecker func(cfg any) bool
+
+// providerModule is a generic module wrapper around any traefik provider.
+type providerModule struct {
+	mu       sync.Mutex
+	loaded   atomic.Bool
+	info     ModuleInfo
+	factory  ProviderFactory
+	checker  ProviderConfigChecker
+	provider provider.Provider
+}
+
+// NewProviderModule creates a module that wraps a provider with lazy loading.
+func NewProviderModule(name, description string, factory ProviderFactory, checker ProviderConfigChecker) ProviderModule {
+	return &providerModule{
+		info: ModuleInfo{
+			Name:        name,
+			Type:        ModuleTypeProvider,
+			Description: description,
+			Version:     "builtin",
+		},
+		factory: factory,
+		checker: checker,
+	}
+}
+
+func (m *providerModule) Info() ModuleInfo {
+	return m.info
+}
+
+func (m *providerModule) Load(_ context.Context, cfg any) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.loaded.Load() {
+		return nil
+	}
+
+	p, err := m.factory(cfg)
+	if err != nil {
+		return err
+	}
+
+	m.provider = p
+	m.loaded.Store(true)
+	log.Info().Str("module", m.info.Name).Msg("Provider module loaded")
+	return nil
+}
+
+func (m *providerModule) Unload(_ context.Context) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	m.provider = nil
+	m.loaded.Store(false)
+	log.Info().Str("module", m.info.Name).Msg("Provider module unloaded")
+	return nil
+}
+
+func (m *providerModule) IsLoaded() bool {
+	return m.loaded.Load()
+}
+
+func (m *providerModule) Provider() provider.Provider {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.provider
+}
+
+func (m *providerModule) IsConfigured(cfg any) bool {
+	return m.checker(cfg)
+}
diff -ruN a/pkg/modules/mod_webui.go b/pkg/modules/mod_webui.go
--- a/pkg/modules/mod_webui.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/mod_webui.go	2026-08-31 21:01:21.549593430 +0200
@@ -0,0 +1,133 @@
+package modules
+
+import (
+	"context"
+	"io/fs"
+	"os"
+	"sync"
+	"sync/atomic"
+
+	"github.com/rs/zerolog/log"
+)
+
+const (
+	// WebUIModuleName is the canonical name for the webui module.
+	WebUIModuleName = "webui"
+
+	// WebUIAssetsDir is the default path where webui static assets are stored
+	// on disk when not embedded. Distributions can place assets here.
+	WebUIAssetsDir = "/usr/share/traefik/webui"
+)
+
+// webUIModule provides the dashboard web interface.
+// It loads its assets lazily and releases them when idle.
+type webUIModule struct {
+	mu     sync.Mutex
+	loaded atomic.Bool
+	assets fs.FS
+
+	// embeddedAssets is set at init time if the binary was built with
+	// embedded webui assets (the default monolithic build).
+	embeddedAssets fs.FS
+
+	// externalDir, if non-empty, overrides where on-disk assets are loaded from.
+	externalDir string
+}
+
+// NewWebUIModule creates a new webui module.
+// If embeddedAssets is non-nil (from webui.FS in a full build), those assets
+// are available immediately when the module is loaded. Otherwise, assets are
+// loaded from disk at WebUIAssetsDir.
+func NewWebUIModule(embeddedAssets fs.FS) *webUIModule {
+	return &webUIModule{
+		embeddedAssets: embeddedAssets,
+	}
+}
+
+// NewWebUIModuleFromDir creates a webui module that loads assets from a
+// specific filesystem directory.
+func NewWebUIModuleFromDir(dir string) *webUIModule {
+	return &webUIModule{
+		externalDir: dir,
+	}
+}
+
+func (m *webUIModule) Info() ModuleInfo {
+	return ModuleInfo{
+		Name:        WebUIModuleName,
+		Type:        ModuleTypeWebUI,
+		Description: "Traefik dashboard web interface",
+		Version:     "builtin",
+	}
+}
+
+func (m *webUIModule) Load(_ context.Context, _ any) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if m.loaded.Load() {
+		return nil
+	}
+
+	// Prefer embedded assets.
+	if m.embeddedAssets != nil {
+		m.assets = m.embeddedAssets
+		m.loaded.Store(true)
+		log.Info().Msg("WebUI module loaded (embedded assets)")
+		return nil
+	}
+
+	// Try loading from disk.
+	dir := m.externalDir
+	if dir == "" {
+		dir = WebUIAssetsDir
+	}
+
+	info, err := os.Stat(dir)
+	if err != nil {
+		if os.IsNotExist(err) {
+			log.Warn().Str("dir", dir).Msg("WebUI assets directory not found, dashboard will be unavailable")
+			m.assets = nil
+			m.loaded.Store(true)
+			return nil
+		}
+		return err
+	}
+
+	if !info.IsDir() {
+		log.Warn().Str("path", dir).Msg("WebUI assets path is not a directory")
+		m.assets = nil
+		m.loaded.Store(true)
+		return nil
+	}
+
+	m.assets = os.DirFS(dir)
+	m.loaded.Store(true)
+	log.Info().Str("dir", dir).Msg("WebUI module loaded (disk assets)")
+	return nil
+}
+
+func (m *webUIModule) Unload(_ context.Context) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	// Release the disk-based FS (allow GC). Embedded assets are retained since
+	// they are compile-time constants and cannot actually be freed.
+	if m.embeddedAssets == nil {
+		m.assets = nil
+	}
+
+	m.loaded.Store(false)
+	log.Info().Msg("WebUI module unloaded")
+	return nil
+}
+
+func (m *webUIModule) IsLoaded() bool {
+	return m.loaded.Load()
+}
+
+func (m *webUIModule) Assets() fs.FS {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return m.assets
+}
diff -ruN a/pkg/modules/module.go b/pkg/modules/module.go
--- a/pkg/modules/module.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/module.go	2026-08-31 21:01:21.549630231 +0200
@@ -0,0 +1,131 @@
+package modules
+
+import (
+	"context"
+	"fmt"
+	"io/fs"
+
+	"github.com/traefik/traefik/v3/pkg/config/dynamic"
+	"github.com/traefik/traefik/v3/pkg/provider"
+	"github.com/traefik/traefik/v3/pkg/safe"
+)
+
+// ModuleType classifies what a module provides.
+type ModuleType int
+
+const (
+	// ModuleTypeProvider is a module that supplies a configuration provider (Docker, Kubernetes, etc.).
+	ModuleTypeProvider ModuleType = iota
+	// ModuleTypeWebUI is a module that supplies dashboard/webui assets.
+	ModuleTypeWebUI
+	// ModuleTypeMetrics is a module that supplies a metrics backend.
+	ModuleTypeMetrics
+	// ModuleTypeCertResolver is a module that supplies a certificate resolver.
+	ModuleTypeCertResolver
+	// ModuleTypeMiddleware is a module that supplies additional middleware.
+	ModuleTypeMiddleware
+)
+
+// ModuleState tracks the lifecycle state of a module.
+type ModuleState int
+
+const (
+	// StateUnloaded means the module is not currently loaded.
+	StateUnloaded ModuleState = iota
+	// StateLoading means the module is being loaded.
+	StateLoading
+	// StateLoaded means the module is loaded and active.
+	StateLoaded
+	// StateUnloading means the module is being unloaded.
+	StateUnloading
+	// StateError means the module failed to load.
+	StateError
+)
+
+// String returns a human-readable name for the state.
+func (s ModuleState) String() string {
+	switch s {
+	case StateUnloaded:
+		return "unloaded"
+	case StateLoading:
+		return "loading"
+	case StateLoaded:
+		return "loaded"
+	case StateUnloading:
+		return "unloading"
+	case StateError:
+		return "error"
+	default:
+		return fmt.Sprintf("unknown(%d)", int(s))
+	}
+}
+
+// ModuleInfo describes a module's metadata.
+type ModuleInfo struct {
+	// Name is the unique module name, e.g. "docker", "kubernetes-crd", "webui".
+	Name string
+
+	// Type classifies what the module provides.
+	Type ModuleType
+
+	// Description is a short human-readable summary.
+	Description string
+
+	// Version is the module's version string.
+	Version string
+}
+
+// Module is the interface every loadable module must implement.
+// Modules are loaded on demand and unloaded when idle.
+// The cfg parameter in Load is expected to be *static.Configuration
+// (passed as any to avoid an import cycle).
+type Module interface {
+	// Info returns metadata about the module.
+	Info() ModuleInfo
+
+	// Load initialises the module with the current static configuration.
+	// The cfg parameter is a pointer to static.Configuration.
+	Load(ctx context.Context, cfg any) error
+
+	// Unload tears down the module, releasing all resources.
+	Unload(ctx context.Context) error
+
+	// IsLoaded reports whether the module is currently loaded.
+	IsLoaded() bool
+}
+
+// ProviderModule is a Module that also supplies a configuration provider.
+type ProviderModule interface {
+	Module
+
+	// Provider returns the configuration provider if the module is loaded.
+	Provider() provider.Provider
+
+	// IsConfigured reports whether the static configuration enables this provider.
+	// The cfg parameter is a pointer to static.Configuration.
+	IsConfigured(cfg any) bool
+}
+
+// WebUIModule is a Module that supplies dashboard/webui assets.
+type WebUIModule interface {
+	Module
+
+	// Assets returns the embedded filesystem with the webui assets.
+	Assets() fs.FS
+}
+
+// ConfigListenerModule is a Module that needs to receive dynamic configuration updates.
+type ConfigListenerModule interface {
+	Module
+
+	// OnConfigUpdate is called whenever the dynamic configuration changes.
+	OnConfigUpdate(conf dynamic.Configuration)
+}
+
+// ProviderLauncherModule is a Module that can launch its provider(s) into the configuration watcher.
+type ProviderLauncherModule interface {
+	Module
+
+	// LaunchProvider starts the provider and feeds configuration into the given channel.
+	LaunchProvider(configurationChan chan<- dynamic.Message, pool *safe.Pool) error
+}
diff -ruN a/pkg/modules/module_test.go b/pkg/modules/module_test.go
--- a/pkg/modules/module_test.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/module_test.go	2026-08-31 21:01:21.549709451 +0200
@@ -0,0 +1,538 @@
+package modules
+
+import (
+	"context"
+	"io/fs"
+	"sync/atomic"
+	"testing"
+	"testing/fstest"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/traefik/traefik/v3/pkg/config/dynamic"
+	"github.com/traefik/traefik/v3/pkg/provider"
+	"github.com/traefik/traefik/v3/pkg/safe"
+)
+
+// --- Test helpers ---
+
+// testModule is a minimal Module implementation for testing.
+type testModule struct {
+	name        string
+	moduleType  ModuleType
+	loaded      atomic.Bool
+	loadCount   atomic.Int32
+	unloadCount atomic.Int32
+	loadErr     error
+}
+
+func newTestModule(name string, mt ModuleType) *testModule {
+	return &testModule{name: name, moduleType: mt}
+}
+
+func (m *testModule) Info() ModuleInfo {
+	return ModuleInfo{
+		Name:        m.name,
+		Type:        m.moduleType,
+		Description: "test module " + m.name,
+		Version:     "test-1.0",
+	}
+}
+
+func (m *testModule) Load(_ context.Context, _ any) error {
+	if m.loadErr != nil {
+		return m.loadErr
+	}
+	m.loaded.Store(true)
+	m.loadCount.Add(1)
+	return nil
+}
+
+func (m *testModule) Unload(_ context.Context) error {
+	m.loaded.Store(false)
+	m.unloadCount.Add(1)
+	return nil
+}
+
+func (m *testModule) IsLoaded() bool {
+	return m.loaded.Load()
+}
+
+// testProviderModule is a ProviderModule for testing.
+type testProviderModule struct {
+	testModule
+	configured bool
+	prov       *testProvider
+}
+
+func newTestProviderModule(name string, configured bool) *testProviderModule {
+	return &testProviderModule{
+		testModule: testModule{name: name, moduleType: ModuleTypeProvider},
+		configured: configured,
+		prov:       &testProvider{},
+	}
+}
+
+func (m *testProviderModule) Provider() provider.Provider {
+	if m.loaded.Load() {
+		return m.prov
+	}
+	return nil
+}
+
+func (m *testProviderModule) IsConfigured(_ any) bool {
+	return m.configured
+}
+
+// testProvider implements provider.Provider.
+type testProvider struct{}
+
+func (p *testProvider) Init() error { return nil }
+func (p *testProvider) Provide(_ chan<- dynamic.Message, _ *safe.Pool) error {
+	return nil
+}
+
+// --- Tests ---
+
+func TestRegistry_RegisterAndGet(t *testing.T) {
+	r := NewRegistry()
+
+	m1 := newTestModule("test1", ModuleTypeProvider)
+	m2 := newTestModule("test2", ModuleTypeWebUI)
+
+	require.NoError(t, r.Register(m1))
+	require.NoError(t, r.Register(m2))
+
+	// Duplicate registration should fail.
+	assert.Error(t, r.Register(m1))
+
+	assert.Equal(t, m1, r.Get("test1"))
+	assert.Equal(t, m2, r.Get("test2"))
+	assert.Nil(t, r.Get("nonexistent"))
+}
+
+func TestRegistry_ListByType(t *testing.T) {
+	r := NewRegistry()
+
+	_ = r.Register(newTestModule("p1", ModuleTypeProvider))
+	_ = r.Register(newTestModule("p2", ModuleTypeProvider))
+	_ = r.Register(newTestModule("w1", ModuleTypeWebUI))
+
+	providers := r.ListByType(ModuleTypeProvider)
+	assert.Len(t, providers, 2)
+
+	webuis := r.ListByType(ModuleTypeWebUI)
+	assert.Len(t, webuis, 1)
+}
+
+func TestRegistry_Unregister(t *testing.T) {
+	r := NewRegistry()
+
+	m := newTestModule("test1", ModuleTypeProvider)
+	_ = r.Register(m)
+	assert.NotNil(t, r.Get("test1"))
+
+	r.Unregister("test1")
+	assert.Nil(t, r.Get("test1"))
+}
+
+func TestRegistry_Names(t *testing.T) {
+	r := NewRegistry()
+
+	_ = r.Register(newTestModule("alpha", ModuleTypeProvider))
+	_ = r.Register(newTestModule("beta", ModuleTypeWebUI))
+
+	names := r.Names()
+	assert.Len(t, names, 2)
+	assert.Contains(t, names, "alpha")
+	assert.Contains(t, names, "beta")
+}
+
+func TestManager_EnsureLoaded(t *testing.T) {
+	r := NewRegistry()
+	m := newTestModule("test1", ModuleTypeProvider)
+	_ = r.Register(m)
+
+	mgr := NewManager(r, nil)
+
+	ctx := context.Background()
+
+	// Module should not be loaded initially.
+	state, err := mgr.GetState("test1")
+	require.NoError(t, err)
+	assert.Equal(t, StateUnloaded, state)
+
+	// Load it.
+	mod, err := mgr.EnsureLoaded(ctx, "test1")
+	require.NoError(t, err)
+	assert.True(t, mod.IsLoaded())
+	assert.Equal(t, int32(1), m.loadCount.Load())
+
+	// Load again — should be idempotent.
+	mod2, err := mgr.EnsureLoaded(ctx, "test1")
+	require.NoError(t, err)
+	assert.Equal(t, mod, mod2)
+	assert.Equal(t, int32(1), m.loadCount.Load())
