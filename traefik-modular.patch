@@ -0,0 +1,96 @@
+package modules
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/rs/zerolog/log"
+	"github.com/traefik/traefik/v3/pkg/provider"
+)
+
+// ModuleAwareAggregator extends the standard ProviderAggregator with module-
+// backed providers. It provides a method to discover and load all configured
+// provider modules on startup.
+type ModuleAwareAggregator struct {
+	manager *Manager
+	cfg     any // *static.Configuration, passed as any.
+}
+
+// NewModuleAwareAggregator creates a helper that can load provider modules.
+// cfg should be a pointer to static.Configuration.
+func NewModuleAwareAggregator(cfg any, manager *Manager) *ModuleAwareAggregator {
+	return &ModuleAwareAggregator{
+		manager: manager,
+		cfg:     cfg,
+	}
+}
+
+// LoadModuleProviders loads all provider modules that are configured.
+// It initialises each module and marks it as essential (providers run
+// continuous watch loops and must not be auto-unloaded).
+func (a *ModuleAwareAggregator) LoadModuleProviders(ctx context.Context) ([]provider.Provider, error) {
+	providerModules := a.manager.registry.ListByType(ModuleTypeProvider)
+
+	var providers []provider.Provider
+
+	for _, mod := range providerModules {
+		pm, ok := mod.(ProviderModule)
+		if !ok {
+			continue
+		}
+
+		if !pm.IsConfigured(a.cfg) {
+			log.Debug().
+				Str("module", mod.Info().Name).
+				Msg("Provider module not configured, skipping")
+			continue
+		}
+
+		loaded, err := a.manager.EnsureLoaded(ctx, mod.Info().Name)
+		if err != nil {
+			log.Error().Err(err).
+				Str("module", mod.Info().Name).
+				Msg("Failed to load provider module")
+			continue
+		}
+
+		lpm, ok := loaded.(ProviderModule)
+		if !ok {
+			continue
+		}
+
+		p := lpm.Provider()
+		if p == nil {
+			continue
+		}
+
+		// Mark provider modules as essential.
+		a.manager.MarkEssential(mod.Info().Name)
+
+		providers = append(providers, p)
+
+		log.Info().
+			Str("module", mod.Info().Name).
+			Msg("Provider module loaded and registered")
+	}
+
+	return providers, nil
+}
+
+// StatusSummary returns a human-readable summary of module states.
+func StatusSummary(manager *Manager) string {
+	statuses := manager.Status()
+	summary := fmt.Sprintf("Module status (%d modules):\n", len(statuses))
+	for _, s := range statuses {
+		essential := ""
+		if s.Essential {
+			essential = " [essential]"
+		}
+		errStr := ""
+		if s.LoadError != nil {
+			errStr = fmt.Sprintf(" error=%v", s.LoadError)
+		}
+		summary += fmt.Sprintf("  %-25s state=%-10s%s%s\n", s.Name, s.State, essential, errStr)
+	}
+	return summary
+}
