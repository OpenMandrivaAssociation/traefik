@@ -0,0 +1,51 @@
+package modules
+
+import (
+	"github.com/traefik/traefik/v3/pkg/config/dynamic"
+	"github.com/traefik/traefik/v3/pkg/provider"
+	consulcatalog "github.com/traefik/traefik/v3/pkg/provider/consulcatalog"
+	consul "github.com/traefik/traefik/v3/pkg/provider/kv/consul"
+	"github.com/traefik/traefik/v3/pkg/provider/nomad"
+	"github.com/traefik/traefik/v3/pkg/safe"
+)
+
+// multiProvider wraps multiple providers (e.g. namespaced consul instances)
+// into a single provider interface.
+type multiProvider struct {
+	providers []provider.Provider
+}
+
+func (m *multiProvider) Init() error {
+	for _, p := range m.providers {
+		if err := p.Init(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *multiProvider) Provide(configurationChan chan<- dynamic.Message, pool *safe.Pool) error {
+	for _, p := range m.providers {
+		if err := p.Provide(configurationChan, pool); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// toProviderSlice converts a typed slice of providers to []provider.Provider.
+func toProviderSlice[T provider.Provider](providers []T) []provider.Provider {
+	result := make([]provider.Provider, len(providers))
+	for i, p := range providers {
+		result[i] = p
+	}
+	return result
+}
+
+// Helper functions to convert typed slices. These use the concrete types
+// returned by each provider's BuildProviders method.
+var (
+	_ = toProviderSlice[*consulcatalog.Provider]
+	_ = toProviderSlice[*consul.Provider]
+	_ = toProviderSlice[*nomad.Provider]
+)
diff -ruN a/pkg/modules/registry.go b/pkg/modules/registry.go
--- a/pkg/modules/registry.go	1970-01-01 01:00:00.000000000 +0100
+++ b/pkg/modules/registry.go	2026-08-31 21:01:21.549779152 +0200
@@ -0,0 +1,128 @@
+package modules
+
+import (
+	"fmt"
+	"sync"
+)
+
+// Registry holds all known modules, both built-in and externally loaded.
+// It is safe for concurrent use.
+type Registry struct {
+	mu      sync.RWMutex
+	modules map[string]Module
+}
+
+// NewRegistry creates a new, empty module registry.
+func NewRegistry() *Registry {
+	return &Registry{
+		modules: make(map[string]Module),
+	}
+}
+
+// Register adds a module to the registry. If a module with the same name
+// already exists, it returns an error.
+func (r *Registry) Register(m Module) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	name := m.Info().Name
+	if _, exists := r.modules[name]; exists {
+		return fmt.Errorf("module %q is already registered", name)
+	}
+	r.modules[name] = m
+	return nil
+}
+
+// Get returns the module with the given name, or nil if not found.
+func (r *Registry) Get(name string) Module {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return r.modules[name]
+}
+
+// GetProvider returns the module as a ProviderModule, or nil if not found
+// or not a provider module.
+func (r *Registry) GetProvider(name string) ProviderModule {
+	m := r.Get(name)
+	if m == nil {
+		return nil
+	}
+	pm, ok := m.(ProviderModule)
+	if !ok {
+		return nil
+	}
+	return pm
+}
+
+// GetWebUI returns the module as a WebUIModule, or nil if not found
+// or not a webui module.
+func (r *Registry) GetWebUI(name string) WebUIModule {
+	m := r.Get(name)
+	if m == nil {
+		return nil
+	}
+	wm, ok := m.(WebUIModule)
+	if !ok {
+		return nil
+	}
+	return wm
+}
+
+// List returns all registered modules.
+func (r *Registry) List() []Module {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	result := make([]Module, 0, len(r.modules))
+	for _, m := range r.modules {
+		result = append(result, m)
+	}
+	return result
+}
+
+// ListByType returns all registered modules of the given type.
+func (r *Registry) ListByType(moduleType ModuleType) []Module {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	var result []Module
+	for _, m := range r.modules {
+		if m.Info().Type == moduleType {
+			result = append(result, m)
+		}
+	}
+	return result
+}
+
+// Names returns the names of all registered modules.
+func (r *Registry) Names() []string {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	names := make([]string, 0, len(r.modules))
+	for name := range r.modules {
+		names = append(names, name)
+	}
+	return names
+}
+
+// RegisterIfAbsent registers m only when no module with the same name exists.
+// Returns true if the module was registered.
+func (r *Registry) RegisterIfAbsent(m Module) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	name := m.Info().Name
+	if _, exists := r.modules[name]; exists {
+		return false
+	}
+	r.modules[name] = m
+	return true
+}
+
+// Unregister removes a module from the registry.
+func (r *Registry) Unregister(name string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	delete(r.modules, name)
+}
