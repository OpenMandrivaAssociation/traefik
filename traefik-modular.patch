+package modules
+
+import (
+	"fmt"
+	"io/fs"
+
+	"github.com/traefik/traefik/v3/pkg/config/static"
+	"github.com/traefik/traefik/v3/pkg/provider"
+)
+
+// RegisterBuiltinModules registers all built-in modules in the given registry.
+// Modules already registered (e.g. from external .so plugins) are left in place.
+// The embeddedWebUI parameter should be webui.FS from the main package if
+// the binary was built with embedded assets (nil otherwise).
+func RegisterBuiltinModules(registry *Registry, embeddedWebUI fs.FS) {
+	registry.RegisterIfAbsent(NewWebUIModule(embeddedWebUI))
+	registry.RegisterIfAbsent(NewDockerModule())
+	registry.RegisterIfAbsent(NewSwarmModule())
+	registry.RegisterIfAbsent(NewKubernetesCRDModule())
+	registry.RegisterIfAbsent(NewKubernetesIngressModule())
+	registry.RegisterIfAbsent(NewKubernetesGatewayModule())
+	registry.RegisterIfAbsent(NewKubernetesIngressNGINXModule())
+	registry.RegisterIfAbsent(NewKnativeModule())
+	registry.RegisterIfAbsent(NewConsulCatalogModule())
+	registry.RegisterIfAbsent(NewConsulModule())
+	registry.RegisterIfAbsent(NewNomadModule())
+	registry.RegisterIfAbsent(NewEtcdModule())
+	registry.RegisterIfAbsent(NewZookeeperModule())
+	registry.RegisterIfAbsent(NewRedisModule())
+	registry.RegisterIfAbsent(NewECSModule())
+	registry.RegisterIfAbsent(NewHTTPModule())
+	registry.RegisterIfAbsent(NewFileModule())
+	registry.RegisterIfAbsent(NewRestModule())
+}
